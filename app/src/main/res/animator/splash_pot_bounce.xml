<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">

    <!-- Pot squashes slightly on Y when coin impacts inside -->
    <set android:ordering="sequentially">
        <!-- Hold until coin enters and impacts (0 - 390ms) -->
        <objectAnimator
            android:duration="390"
            android:propertyName="scaleY"
            android:valueFrom="1.0"
            android:valueTo="1.0"
            android:valueType="floatType" />
        <!-- Squash upon impact (390 - 460ms) -->
        <objectAnimator
            android:duration="70"
            android:interpolator="@android:interpolator/decelerate_quad"
            android:propertyName="scaleY"
            android:valueFrom="1.0"
            android:valueTo="0.93"
            android:valueType="floatType" />
        <!-- Spring rebound back to normal (460 - 620ms) -->
        <objectAnimator
            android:duration="160"
            android:interpolator="@android:interpolator/overshoot"
            android:propertyName="scaleY"
            android:valueFrom="0.93"
            android:valueTo="1.0"
            android:valueType="floatType" />
    </set>

    <!-- Pot stretches horizontally on X on impact -->
    <set android:ordering="sequentially">
        <!-- Hold until impact (0 - 390ms) -->
        <objectAnimator
            android:duration="390"
            android:propertyName="scaleX"
            android:valueFrom="1.0"
            android:valueTo="1.0"
            android:valueType="floatType" />
        <!-- Stretch upon impact (390 - 460ms) -->
        <objectAnimator
            android:duration="70"
            android:interpolator="@android:interpolator/decelerate_quad"
            android:propertyName="scaleX"
            android:valueFrom="1.0"
            android:valueTo="1.06"
            android:valueType="floatType" />
        <!-- Spring rebound back to normal (460 - 620ms) -->
        <objectAnimator
            android:duration="160"
            android:interpolator="@android:interpolator/overshoot"
            android:propertyName="scaleX"
            android:valueFrom="1.06"
            android:valueTo="1.0"
            android:valueType="floatType" />
    </set>

</set>
